{
  "name": "pixelart",
  "private": true,
  "version": "2.0.0",
  "description": "Turn an image into a moving pixel animation (X-ray, classic, photo styles) and export it as video or an embed",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "legacy:build-demo": "esbuild legacy/page-transition/demo/demo.tsx --bundle --minify --format=iife --target=es2019 --alias:framer=./legacy/page-transition/demo/framer-stub.ts --define:process.env.NODE_ENV=\\\"production\\\" --outfile=legacy/page-transition/demo/demo.js"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  }
}

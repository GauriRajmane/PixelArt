{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "baseUrl": ".",
    "paths": { "framer": ["legacy/page-transition/demo/framer-stub.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "legacy/page-transition/FlowerTransition.tsx", "legacy/page-transition/demo/*.ts", "legacy/page-transition/demo/*.tsx"]
}
